# Backend API URL (leave empty in local dev to use Vite proxy, or specify deployed backend URL)
# Example: https://my-ecommerce-api.onrender.com
VITE_API_URL=

# Stripe Publishable Key (from Stripe Dashboard > Developers > API keys)
# Example: pk_test_51...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_enter_your_stripe_publishable_key
